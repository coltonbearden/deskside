#!/bin/sh
# deskside pre-commit: no secrets and no personal data in what's being committed.
# Enabled with: git config core.hooksPath .githooks
set -e
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --staged --no-banner --redact --exit-code 1 --config .gitleaks.toml
else
  echo "pre-commit: gitleaks is not installed; install it before committing." >&2
  exit 1
fi
if command -v pwsh >/dev/null 2>&1; then
  pwsh -NoProfile -File tools/Test-PersonalData.ps1
else
  powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/Test-PersonalData.ps1
fi
